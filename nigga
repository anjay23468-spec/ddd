DFunction.ScanDescendantsAsync = function(Root, MatchFolderName, TargetName, Callback)
    local Stack = {}
    for _, Child in ipairs(Root:GetChildren()) do
        table.insert(Stack, Child)
    end
    local Iterations = 0
    local Found = nil
    local function Step()
        while #Stack > 0 do
            local Node = table.remove(Stack)
            if Node:IsA("Folder") or Node:IsA("Model") then
                if MatchFolderName and Node.Name == MatchFolderName then
                    local function FindInFolder(Folder, Name)
                        for _, Child in ipairs(Folder:GetChildren()) do
                            if Child.Name == Name then return Child end
                            local Result = FindInFolder(Child, Name)
                            if Result then return Result end
                        end
                        return nil
                    end
                    local InnerResult = FindInFolder(Node, TargetName)
                    if InnerResult then
                        Found = InnerResult
                        break
                    end
                elseif not MatchFolderName and Node.Name == TargetName then
                    Found = Node
                    break
                else
                    for _, Child in ipairs(Node:GetChildren()) do
                        table.insert(Stack, Child)
                    end
                end
            end
            Iterations = Iterations + 1
            if Iterations % 100 == 0 then
                task.wait()
            end
        end
    end
    coroutine.wrap(function()
        Step()
        Callback(Found)
    end)()
end

DFunction.SwapCosmetics = function(Current, Target, OnComplete)
    if Current == "" or Target == "" or Current == Target then
        OnComplete(false)
        return
    end
    local Key = Current .. "_" .. Target
    if DConfiguration.CosmeticChanger.CosSwaps[Key] then
        local Old = DConfiguration.CosmeticChanger.CosSwaps[Key]
        DFunction.SwapCosmetics(Old.Target, Old.Current, function() end)
        DConfiguration.CosmeticChanger.CosSwaps[Key] = nil
    end
    local Items = ReplicatedStorage:FindFirstChild("Items")
    if not Items then
        OnComplete(false)
        return
    end
    local CurFound, TarFound = nil, nil
    local function CheckDone()
        if CurFound and TarFound then
            local Cur = CurFound
            local Tar = TarFound
            local Temp = Instance.new("Folder")
            Temp.Name = "__temp_cos_swap_" .. tostring(tick())
            Temp.Parent = ReplicatedStorage or workspace
            local CurChildren = {}
            local TarChildren = {}
            for _, Child in ipairs(Cur:GetChildren()) do table.insert(CurChildren, Child) end
            for _, Child in ipairs(Tar:GetChildren()) do table.insert(TarChildren, Child) end
            for _, Child in ipairs(CurChildren) do Child.Parent = Temp end
            for _, Child in ipairs(TarChildren) do Child.Parent = Cur end
            for _, Child in ipairs(Temp:GetChildren()) do Child.Parent = Tar end
            Temp:Destroy()
            DConfiguration.CosmeticChanger.CosSwaps[Key] = { Current = Current, Target = Target }
            OnComplete(true)
        end
    end
    DFunction.ScanDescendantsAsync(Items, "Cosmetics", Current, function(Result)
        CurFound = Result
        CheckDone()
    end)
    DFunction.ScanDescendantsAsync(Items, "Cosmetics", Target, function(Result)
        TarFound = Result
        CheckDone()
    end)
end

DFunction.ResetAllCosmetics = function(OnComplete)
    local List = {}
    for _, V in pairs(DConfiguration.CosmeticChanger.CosSwaps) do table.insert(List, V) end
    local Count = #List
    if Count == 0 then
        OnComplete()
        return
    end
    local Done = 0
    for _, V in ipairs(List) do
        DFunction.SwapCosmetics(V.Target, V.Current, function()
            Done = Done + 1
            if Done == Count then
                DConfiguration.CosmeticChanger.CosSwaps = {}
                OnComplete()
            end
        end)
    end
end

