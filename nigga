local function GetPlayerDownedForFarm(Player)
    if not Player or not Player.Character then return false end
    local Hum = Player.Character:FindFirstChildOfClass("Humanoid")
    return Hum and Hum.Health <= 0
end

local function TeleportToSecurityPart(Offset)
    local Part = workspace:FindFirstChild("SecurityPart")
    if Part then
        local Char = LocalPlayer.Character
        if Char and Char:FindFirstChild("HumanoidRootPart") then
            Char.HumanoidRootPart.CFrame = CFrame.new(Part.Position + Offset)
        end
    end
end

DFunction.StartAutoFarm = function()
    DConfiguration.AutoFarm.Connection = RunService.Heartbeat:Connect(function()
        local Char = LocalPlayer.Character
        local Hrp = Char and Char:FindFirstChild("HumanoidRootPart")
        if not Hrp then return end
        TeleportToSecurityPart(Vector3.new(0, 3, 0))
        if table.find(DConfiguration.AutoFarm.Modes, "Auto Ticket") then
            local TF = workspace:FindFirstChild("Effects") and workspace.Effects:FindFirstChild("Tickets")
            local Ticket = TF and TF:GetChildren()[1]
            if Ticket then
                local Target = Ticket:FindFirstChild("HumanoidRootPart") or Ticket:FindFirstChildWhichIsA("BasePart")
                if Target then Hrp.CFrame = Target.CFrame + Vector3.new(0, 3, 0) end
            end
        end
        if table.find(DConfiguration.AutoFarm.Modes, "Auto Complete Objective") then
            local ObjContainer = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Parts") and workspace.Map.Parts:FindFirstChild("Objectives")
            if ObjContainer then
                local AnyCompleted = false
                for _, Obj in pairs(ObjContainer:GetChildren()) do
                    if Obj:GetAttribute("Completed") == true then AnyCompleted = true; break end
                end
                if not AnyCompleted then
                    for _, Objective in pairs(ObjContainer:GetChildren()) do
                        if Objective:FindFirstChild("WhenActivated") then
                            local TagValue = Objective:GetAttribute("Tag")
                            if TagValue then
                                Hrp.CFrame = CFrame.new(Objective:GetPivot().Position)
                                task.wait(0.1)
                                ReplicatedStorage.Events.Interact:FireServer("Dynamic", TagValue)
                                task.wait(0.2)
                            end
                        end
                    end
                end
            end
        end
        if table.find(DConfiguration.AutoFarm.Modes, "Auto Token") then
            for _, Player in ipairs(Players:GetPlayers()) do
                if Player ~= LocalPlayer and GetPlayerDownedForFarm(Player) and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
                    Hrp.CFrame = Player.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                    pcall(function()
                        ReplicatedStorage:WaitForChild("Services"):WaitForChild("Client"):WaitForChild("KeybindService"):WaitForChild("SendKeybindEvent"):Fire({ Down = true, Key = "Interact" })
                    end)
                    break
                end
            end
        end
    end)
end

