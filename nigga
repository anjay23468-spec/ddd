DFunction.SelfReviveRespawn = function()
    local Char = LocalPlayer.Character
    if not Char or DConfiguration.SelfRevive.IsReviving then return end
    local IsDowned = false
    pcall(function()
        local CD = CharacterService:GetCharacterFromPlayer(LocalPlayer)
        if CD and CD.DataRegistry then IsDowned = CD.DataRegistry:Get("Downed") == true end
    end)
    if not IsDowned then return end
    local Hrp = Char:FindFirstChild("HumanoidRootPart")
    DConfiguration.SelfRevive.IsReviving = true
    if DConfiguration.SelfRevive.Method == "Spawnpoint" then
        if not DConfiguration.SelfRevive.HasRevived then
            DConfiguration.SelfRevive.HasRevived = true
            pcall(function() DConfiguration.SelfRevive.ChangeMode:FireServer(true) end)
            task.delay(10, function() DConfiguration.SelfRevive.HasRevived = false end)
            task.delay(1, function() DConfiguration.SelfRevive.IsReviving = false end)
        else
            DConfiguration.SelfRevive.IsReviving = false
        end
    elseif DConfiguration.SelfRevive.Method == "Fake Revive" then
        local SavedPos = Hrp and Hrp.CFrame.Position
        task.spawn(function()
            pcall(function() DConfiguration.SelfRevive.ChangeMode:FireServer(true) end)
            local NewChar
            repeat NewChar = LocalPlayer.Character; task.wait() until NewChar and NewChar:FindFirstChild("HumanoidRootPart") and NewChar ~= Char
            if NewChar then
                local NewHrp = NewChar:FindFirstChild("HumanoidRootPart")
                if SavedPos and NewHrp then
                    task.wait(0.1)
                    NewHrp.CFrame = CFrame.new(SavedPos)
                end
            end
            DConfiguration.SelfRevive.IsReviving = false
        end)
    end
end

