if DConfiguration.Player.EspMainMovement and DConfiguration.Player.EspMainMovement.RegistryTermUpdated then
    local OrigRegistryTermUpdated = DConfiguration.Player.EspMainMovement.RegistryTermUpdated
    DConfiguration.Player.EspMainMovement.RegistryTermUpdated = function(Self, Term, ...)
        if Term == "Emote" then
            local Id = Self.DataRegistry:Get("Emote")
            if Id and Id ~= 0 then
                local Item = ClientItemService and ClientItemService:GetItemFromID(Id)
                    or ReplicatedStorage.Items:FindFirstChild(tostring(Id), true)
                local Mult = Item and (require(Item).EmoteInfo or {}).SpeedMult or 1
                if DConfiguration.Player.EmoteSpeedEnabled and DConfiguration.Player.EmoteSpeedType == "Blatant" then
                    Self.MoveStats:SpeedChange("Emote", Mult * (DConfiguration.Player.EmoteSpeedValue / 1000))
                else
                    Self.MoveStats:SpeedChange("Emote", Mult)
                end
            else
                Self.MoveStats:SpeedChange("Emote", nil)
            end
            return
        end
        return OrigRegistryTermUpdated(Self, Term, ...)
    end
end

