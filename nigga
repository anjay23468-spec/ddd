            DConfiguration.AntiBotSpawn.Connection = RunService.Heartbeat:Connect(function()
                local Char = LocalPlayer.Character
                if not Char or not Char:FindFirstChild("HumanoidRootPart") then return end
                local Root = Char.HumanoidRootPart
                local Att = nil
                for _, Parent in pairs({Workspace:FindFirstChild("Terrain"), Workspace, Workspace:FindFirstChild("Game")}) do
                    if Parent then Att = Parent:FindFirstChild("NextbotSpawnAttachment") end
                    if Att then break end
                end
                if not Att then return end
                local SpawnPos = Att.WorldCFrame.Position
                if (Root.Position - SpawnPos).Magnitude < DConfiguration.AntiBotSpawn.Distance then
                    local Target = GetSafeCFrame(DConfiguration.AntiBotSpawn.TeleportType, Root, DConfiguration.AntiBotSpawn.TeleportDistance, SpawnPos)
                    if Target then Root.CFrame = Target end
                end
            end)
        else
            if DConfiguration.AntiBotSpawn.Connection then DConfiguration.AntiBotSpawn.Connection:Disconnect(); DConfiguration.AntiBotSpawn.Connection = nil end
        end
    end
})
