local function CalculateBoxScale(Distance)
    if Distance <= 17 then return 1 else return math.max(17 / Distance, 0.013) end
end

local function GetRootPart(Model)
    if not Model then return nil end
    return Model:FindFirstChild("HumanoidRootPart")
        or Model:FindFirstChild("Torso")
        or Model:FindFirstChild("UpperTorso")
        or Model:FindFirstChild("LowerTorso")
        or Model:FindFirstChild("Head")
end

local function GetDistanceFromCamera(TargetPosition)
    local Cam = workspace.CurrentCamera
    if not Cam then return 0 end
    return (TargetPosition - Cam.CFrame.Position).Magnitude
end

local function GetPlayerDowned(Player)
    if not Player or not Player.Character then return false end
    local Char = Player.Character
    local Hum = Char:FindFirstChildOfClass("Humanoid")
    if Hum and Hum.Health <= 0 then return true end
    if Char:GetAttribute("Downed") == true then return true end
    return false
end

local function ScanRigs()
    local Rigs = {}
    for _, Obj in ipairs(workspace:GetDescendants()) do
        if string.find(Obj.Name, "Rigs") then
            if Obj:IsA("Model") then
                table.insert(Rigs, Obj)
            elseif Obj:IsA("Folder") then
                for _, Child in ipairs(Obj:GetChildren()) do
                    if Child:IsA("Model") then
                        table.insert(Rigs, Child)
                    end
                end
            end
        end
    end
    return Rigs
end

local function UpdateRigCache()
    DConfiguration.Esp.RigOwner = {}
    DConfiguration.Esp.PlayerRigs = {}
    DConfiguration.Esp.RigCache = ScanRigs()
    local AllPlayers = Players:GetPlayers()
    for _, Rig in ipairs(DConfiguration.Esp.RigCache) do
        for _, Player in ipairs(AllPlayers) do
            if Player.Name == Rig.Name then
                DConfiguration.Esp.RigOwner[Rig] = Player
                if not DConfiguration.Esp.PlayerRigs[Player] then
                    DConfiguration.Esp.PlayerRigs[Player] = {}
                end
                table.insert(DConfiguration.Esp.PlayerRigs[Player], Rig)
                break
            end
        end
    end
end

