end

local function StopEsp()
    DConfiguration.Esp.Enabled = false
    if DConfiguration.Esp.Connections.Render then
        DConfiguration.Esp.Connections.Render:Disconnect()
        DConfiguration.Esp.Connections.Render = nil
    end
    CleanupEsp()
end

