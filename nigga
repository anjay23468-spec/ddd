local EspCategoryColors = {
    Alive   = Color3.fromRGB(0, 255, 0),
    Downed  = Color3.fromRGB(255, 255, 0),
    Nextbot = Color3.fromRGB(255, 0, 0),
    Ticket  = Color3.fromRGB(0, 150, 255),
    Vehicle = Color3.fromRGB(255, 105, 180),
}

local function CreateTracer(Color)
    local Line = Drawing.new("Line")
    Line.Thickness = 1
    Line.Color = Color or EspCategoryColors.Alive
    Line.Transparency = 1
    Line.Visible = false
    return Line
end

local function UpdateTracer(Tracer, Model, Color, Settings)
    if not Tracer then return end
    local RootPart = GetRootPart(Model)
    if not RootPart or not RootPart:IsDescendantOf(workspace) then
        Tracer.Visible = false
        return
    end
    local ScreenPos, OnScreen = Camera:WorldToViewportPoint(RootPart.Position)
    if OnScreen then
        local Pos = (Settings and Settings.TracerPosition) or "Top"
        local Vp = Camera.ViewportSize
        local From
        if Pos == "Top" then From = Vector2.new(Vp.X / 2, 0)
        elseif Pos == "Center" then From = Vector2.new(Vp.X / 2, Vp.Y / 2)
        else From = Vector2.new(Vp.X / 2, Vp.Y) end
        Tracer.Color = Color or EspCategoryColors.Alive
        Tracer.Thickness = 1
        Tracer.Transparency = 1
        Tracer.From = From
        Tracer.To = Vector2.new(ScreenPos.X, ScreenPos.Y)
        Tracer.Visible = true
    else
        Tracer.Visible = false
        Tracer.Transparency = 1
    end
end

local function RemoveTracer(Tracer)
    if Tracer then pcall(function() Tracer:Remove() end) end
end

local function CleanupElements(ElementsTable)
    for Model, Esp in pairs(ElementsTable) do
        if Esp.Box2D then Remove2DBox(Model) end
        if Esp.Box3D then Remove3DBox(Model) end
        if Esp.Billboard then
            local RootPart = GetRootPart(Model)
            if RootPart then
                local Bill = RootPart:FindFirstChild("Esp_Billboard")
                if Bill then Bill:Destroy() end
            end
        end
        if Esp.Tracer then RemoveTracer(Esp.Tracer) end
        RemoveHighlight(Model)
    end
    table.clear(ElementsTable)
end

local function CleanupEsp()
    CleanupElements(DConfiguration.Esp.AliveElements)
    CleanupElements(DConfiguration.Esp.DownedElements)
    CleanupElements(DConfiguration.Esp.NextbotElements)
    CleanupElements(DConfiguration.Esp.TicketElements)
    CleanupElements(DConfiguration.Esp.VehicleElements)
    RemoveAllHighlights()
end

local function UpdateGenericEsp(Targets, Color, Settings, ElementsTable, SkipHighlights, EnableTracer)
    local CurrentTargets = {}
    for _, Target in ipairs(Targets) do
        local Model = Target.Model
        if not Model or not Model.Parent then continue end
        local RootPart = GetRootPart(Model)
        if not RootPart then continue end
        CurrentTargets[Model] = true
        if not ElementsTable[Model] then ElementsTable[Model] = {} end
        local Esp = ElementsTable[Model]
        local Dist = GetDistanceFromCamera(RootPart.Position)
        local Scale = CalculateBoxScale(Dist)
        if Settings.Boxes then
            if Settings.BoxType == "3D" then
                if not Esp.Box3D then Esp.Box3D = Create3DBox(Model, Color) else Update3DBoxColor(Model, Color) end
                if Esp.Box2D then Remove2DBox(Model); Esp.Box2D = nil end
            else
                if not Esp.Box2D then Esp.Box2D = Create2DBox(Model, Color, Scale) else Update2DBox(Esp.Box2D, Color, Scale) end
                if Esp.Box3D then Remove3DBox(Model); Esp.Box3D = nil end
            end
        else
            if Esp.Box2D then Remove2DBox(Model); Esp.Box2D = nil end
            if Esp.Box3D then Remove3DBox(Model); Esp.Box3D = nil end
        end
        if Settings.Names or Settings.Distance then
            if not Esp.Billboard then Esp.Billboard = CreateBillboard(Model, Target.Name, Color) end
            UpdateBillboard(Esp.Billboard, Settings.Names and Target.Name or nil, Settings.Distance and Dist or nil, Color)
        else
            if Esp.Billboard then
                local RootPart2 = GetRootPart(Model)
                if RootPart2 then
                    local Bill = RootPart2:FindFirstChild("Esp_Billboard")
                    if Bill then Bill:Destroy() end
                end
                Esp.Billboard = nil
            end
        end
        if not SkipHighlights and Settings.Highlights then
            AddHighlight(Model, Color)
        else
            RemoveHighlight(Model)
        end
        if EnableTracer and Settings.Tracer then
            if not Esp.Tracer then Esp.Tracer = CreateTracer(Color) end
            UpdateTracer(Esp.Tracer, Model, Color, Settings)
        else
            if Esp.Tracer then RemoveTracer(Esp.Tracer); Esp.Tracer = nil end
        end
    end
    for Model, Esp in pairs(ElementsTable) do
        if not CurrentTargets[Model] then
            if Esp.Box2D then Remove2DBox(Model) end
            if Esp.Box3D then Remove3DBox(Model) end
            if Esp.Billboard then
                local RootPart = GetRootPart(Model)
                if RootPart then
                    local Bill = RootPart:FindFirstChild("Esp_Billboard")
                    if Bill then Bill:Destroy() end
                end
            end
            if Esp.Tracer then RemoveTracer(Esp.Tracer) end
            RemoveHighlight(Model)
            ElementsTable[Model] = nil
        end
    end
end

local function UpdateEsp()
    if not DConfiguration.Esp.Rendering or not DConfiguration.Esp.WindowFocused then return end
    if not workspace.CurrentCamera then return end
    if tick() - DConfiguration.Esp.LastRigUpdate > 5 then
        UpdateRigCache()
        DConfiguration.Esp.LastRigUpdate = tick()
    end
    local AliveTargets = {}
    local DownedTargets = {}
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player == LocalPlayer then continue end
        local Char = Player.Character
        if not Char then continue end
        local Hum = Char:FindFirstChild("Humanoid")
        if not Hum then continue end
        if GetPlayerDowned(Player) then
            table.insert(DownedTargets, { Model = Char, Name = Player.Name })
        elseif Hum.Health > 0 then
            table.insert(AliveTargets, { Model = Char, Name = Player.Name })
        end
    end
    UpdateGenericEsp(
        DConfiguration.Esp.Settings.Enabled and AliveTargets or {},
        EspCategoryColors.Alive, DConfiguration.Esp.Settings, DConfiguration.Esp.AliveElements, false, true)
    UpdateGenericEsp(
        DConfiguration.Esp.DownedSettings.Enabled and DownedTargets or {},
        EspCategoryColors.Downed, DConfiguration.Esp.DownedSettings, DConfiguration.Esp.DownedElements, false, true)
    local NextbotTargets = {}
    local PlayersFolder = workspace:FindFirstChild("Players")
    if PlayersFolder then
        for _, Model in ipairs(PlayersFolder:GetChildren()) do
            if Model:IsA("Model") and Model:GetAttribute("Team") == "Nextbot" then
                table.insert(NextbotTargets, { Model = Model, Name = Model.Name })
            end
        end
    end
    for _, Rig in ipairs(DConfiguration.Esp.RigCache) do
        if Rig:GetAttribute("Team") == "Nextbot" then
            table.insert(NextbotTargets, { Model = Rig, Name = Rig.Name })
        end
    end
    UpdateGenericEsp(
        DConfiguration.Esp.NextbotSettings.Enabled and NextbotTargets or {},
        EspCategoryColors.Nextbot, DConfiguration.Esp.NextbotSettings, DConfiguration.Esp.NextbotElements, true, true)
    local TicketTargets = {}
    local Effects = workspace:FindFirstChild("Effects")
    if Effects then
        local TicketsFolder = Effects:FindFirstChild("Tickets")
        if TicketsFolder then
            for _, Model in ipairs(TicketsFolder:GetChildren()) do
                if Model:IsA("Model") then
                    table.insert(TicketTargets, { Model = Model, Name = Model.Name })
                end
            end
        end
    end
    UpdateGenericEsp(
        DConfiguration.Esp.TicketSettings.Enabled and TicketTargets or {},
        EspCategoryColors.Ticket, DConfiguration.Esp.TicketSettings, DConfiguration.Esp.TicketElements, false, true)
    local VehicleTargets = {}
    local VehiclesFolder = workspace:FindFirstChild("Vehicles")
    if VehiclesFolder then
        for _, Model in ipairs(VehiclesFolder:GetChildren()) do
            if Model:IsA("Model") then
                table.insert(VehicleTargets, { Model = Model, Name = Model.Name })
            end
        end
    end
    UpdateGenericEsp(
        DConfiguration.Esp.VehicleSettings.Enabled and VehicleTargets or {},
        EspCategoryColors.Vehicle, DConfiguration.Esp.VehicleSettings, DConfiguration.Esp.VehicleElements, false, true)
end

