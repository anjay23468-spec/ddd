local function GetSafeCFrame(TeleportType, Root, TeleportDist, AvoidPos)
    if TeleportType == "Safe Part" then
        local SecurityPart = Workspace:FindFirstChild("SecurityPart")
        if SecurityPart then return SecurityPart.CFrame + Vector3.new(0, 3, 0) end
        return Root.CFrame
    elseif TeleportType == "Spawn" then
        local Spawns = {}
        for _, V in pairs(Workspace:GetDescendants()) do
            if V:IsA("SpawnLocation") then table.insert(Spawns, V) end
        end
        if #Spawns > 0 then return Spawns[math.random(#Spawns)].CFrame + Vector3.new(0, 3, 0) end
        return Root.CFrame
    elseif TeleportType == "Distance" then
        for _ = 1, 20 do
            local Angle = math.random() * math.pi * 2
            local Dist = math.random(30, TeleportDist or 100)
            local Offset = Vector3.new(math.cos(Angle) * Dist, 0, math.sin(Angle) * Dist)
            local Tp = Root.Position + Offset + Vector3.new(0, 10, 0)
            local Ray = Workspace:Raycast(Tp, Vector3.new(0, -50, 0))
            if Ray then Tp = Ray.Position + Vector3.new(0, 3, 0) end
            if not AvoidPos or (Tp - AvoidPos).Magnitude >= 51 then return CFrame.new(Tp) end
        end
        return Root.CFrame + Root.CFrame.LookVector * (TeleportDist or 100)
    elseif TeleportType == "Players" then
        local Others = {}
        for _, P in pairs(Players:GetPlayers()) do
            if P ~= LocalPlayer and P.Character and P.Character:FindFirstChild("HumanoidRootPart") then table.insert(Others, P) end
        end
        if #Others > 0 then return Others[math.random(#Others)].Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0) end
        return Root.CFrame
    end
    return Root.CFrame
end

