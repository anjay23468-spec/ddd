local BhopMovement = GetMovementModule()
local BhopOriginalUpdate = BhopMovement and BhopMovement.Update
local BhopLastFriction = nil

local function BhopMovementValueSet(MovType, Value)
    if Value == nil then return end
    local Tag = LocalPlayer.Character and LocalPlayer.Character:GetAttribute("Tag")
    if not Tag then return end
    pcall(function()
        firesignal(ReplicatedStorage.Events.CharacterTask.OnClientEvent, Tag, "ModifyMovement", { MovType, Value })
    end)
end

local function BhopGetCurrentSpeed(Character)
    if not Character then return 0 end
    local Hrp = Character:FindFirstChild("HumanoidRootPart")
    if not Hrp then return 0 end
    for _, Child in ipairs(Hrp:GetChildren()) do
        if Child:IsA("LinearVelocity") and Child.Name:find("LinearVelocity") then
            local Pv = Child.PlaneVelocity
            return (Pv.X * Pv.X + Pv.Y * Pv.Y) ^ 0.5
        end
    end
    local Vel = Hrp.AssemblyLinearVelocity
    return (Vel.X * Vel.X + Vel.Z * Vel.Z) ^ 0.5
end

local function BhopUpdateEnabled()
    local ShouldEnable = (DConfiguration.Bhop.AutoJumpEnabled or DConfiguration.Bhop.HoldEnabled) and DConfiguration.Bhop.AccelerationMethod == "Acceleration"
    BhopMovementValueSet("BhopEnabled", ShouldEnable)
end

if BhopMovement then
    BhopMovement.Update = function(Self, ...)
        BhopOriginalUpdate(Self, ...)
        local Humanoid = Self.Character and Self.Character:FindFirstChild("Humanoid")
        if not Humanoid then return end
        local Grounded = Self.DataRegistry:Get("Grounded")
        local State = Self.State
        local DesiredFriction = nil
        if DConfiguration.Player.InfiniteSlideEnabled then
            local IsSlide = State == "Slide" or State == "EmotingSlide" or State == "CarrySlide"
            if IsSlide then DesiredFriction = DConfiguration.Player.SlideFriction end
        end
        if DesiredFriction == nil and DConfiguration.Bhop.AccelerationMethod == "Acceleration" then
            local IsBhopActive = DConfiguration.Bhop.AutoJumpEnabled or (DConfiguration.Bhop.HoldEnabled and Humanoid.Jump == true)
            if IsBhopActive and not Grounded then
                local CurrentSpeed = BhopGetCurrentSpeed(Self.Character)
                if DConfiguration.Bhop.AutoAccelEnabled then
                    if CurrentSpeed > DConfiguration.Bhop.MaxAutoAccelSpeed then
                        DesiredFriction = DConfiguration.Bhop.MaxAcceleration
                    elseif CurrentSpeed < DConfiguration.Bhop.MaxAutoAccelSpeed then
                        DesiredFriction = DConfiguration.Bhop.MinAcceleration
                    else
                        DesiredFriction = DConfiguration.Bhop.AccelerationValue
                    end
                else
                    DesiredFriction = DConfiguration.Bhop.AccelerationValue
                end
            end
        end
        if DesiredFriction ~= BhopLastFriction then
            BhopMovementValueSet("Friction", DesiredFriction ~= nil and DesiredFriction or 5)
            BhopLastFriction = DesiredFriction
        end
        if (State == "WallrunRight" or State == "WallrunLeft") and DConfiguration.Bhop.AutoWallHop then
            Self:AttemptJump()
        end
        if DConfiguration.Bhop.AutoJumpEnabled and Grounded then
            if DConfiguration.Bhop.AutoJumpType == "Realistic" then
                Self:AttemptJump()
            else
                Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
        if DConfiguration.Bhop.HoldEnabled and Grounded and Humanoid.Jump == true then
            Self:AttemptJump()
        end
    end
end

