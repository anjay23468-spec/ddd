local function FakeAhhTrimpUpdate(Self, Dt)
    DConfiguration.FakeTrimp.OldUpdate(Self, Dt)
    if not DConfiguration.FakeTrimp.Enabled then DConfiguration.FakeTrimp.CurrentSpeed = 0; return end
    local Hrp = Self.Character and Self.Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Self.Character and Self.Character:FindFirstChildOfClass("Humanoid")
    if not Hrp or not Humanoid then return end
    local MoveDir = Vector3.new()
    if DConfiguration.FakeTrimp.MovementType == "Camera" then
        local Cam = workspace.CurrentCamera
        if Cam then
            local LookDir = Cam.CFrame:VectorToWorldSpace(DConfiguration.FakeTrimp.CameraDirection)
            MoveDir = Vector3.new(LookDir.X, 0, LookDir.Z).Unit
        end
    else
        MoveDir = Humanoid.MoveDirection
    end
    if MoveDir.Magnitude > 0 then DConfiguration.FakeTrimp.State.MoveDir = MoveDir.Unit end
    local TargetSpeed = DConfiguration.FakeTrimp.MaxSpeed * 90
    if DConfiguration.FakeTrimp.SmoothAcceleration then
        DConfiguration.FakeTrimp.CurrentSpeed = DConfiguration.FakeTrimp.CurrentSpeed + (TargetSpeed - DConfiguration.FakeTrimp.CurrentSpeed) * math.min(DConfiguration.FakeTrimp.SpeedAcceleration * Dt, 1)
    else
        DConfiguration.FakeTrimp.CurrentSpeed = TargetSpeed
    end
    local NewVelocity = DConfiguration.FakeTrimp.State.MoveDir * DConfiguration.FakeTrimp.CurrentSpeed
    Self.DataRegistry:Set("Velocity", NewVelocity)
    local Horizontal = Vector3.new(NewVelocity.X, 0, NewVelocity.Z) / 90
    Hrp.AssemblyLinearVelocity = Vector3.new(Horizontal.X, Hrp.AssemblyLinearVelocity.Y, Horizontal.Z)
end

