local function Create2DBox(Model, Color, Scale)
    local RootPart = GetRootPart(Model)
    if not RootPart then return nil end
    local Existing = Model:FindFirstChild("Esp_2DBox")
    if Existing then Existing:Destroy() end
    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "Esp_2DBox"
    Billboard.Adornee = RootPart
    Billboard.Parent = RootPart
    Billboard.AlwaysOnTop = true
    Billboard.Size = UDim2.new(0, 80 * Scale, 0, 100 * Scale)
    Billboard.StudsOffset = Vector3.new(0, 0, 0)
    Billboard.ClipsDescendants = false
    local BoxFrame = Instance.new("Frame")
    BoxFrame.Name = "BoxFrame"
    BoxFrame.Size = UDim2.new(1, 0, 1, 0)
    BoxFrame.BackgroundTransparency = 1
    BoxFrame.BorderSizePixel = 0
    BoxFrame.Parent = Billboard
    local Stroke = Instance.new("UIStroke")
    Stroke.Thickness = math.max(1.5 * Scale, 1)
    Stroke.Transparency = 0
    Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    Stroke.Color = Color
    Stroke.Parent = BoxFrame
    return { Billboard = Billboard, BoxFrame = BoxFrame, Stroke = Stroke, Scale = Scale }
end

local function Update2DBox(BoxData, Color, Scale)
    if not BoxData then return end
    if BoxData.Stroke then BoxData.Stroke.Color = Color end
    if BoxData.Billboard then BoxData.Billboard.Size = UDim2.new(0, 80 * Scale, 0, 100 * Scale) end
    if BoxData.Stroke then BoxData.Stroke.Thickness = math.max(1.5 * Scale, 1) end
    BoxData.Scale = Scale
end

local function Remove2DBox(Model)
    local RootPart = GetRootPart(Model)
    if RootPart then
        local Box = RootPart:FindFirstChild("Esp_2DBox")
        if Box then Box:Destroy() end
    end
end

local function Create3DBox(Model, Color, Size)
    local RootPart = GetRootPart(Model)
    if not RootPart then return nil end
    local FolderName = "Esp_3DBox"
    local Folder = Model:FindFirstChild(FolderName)
    if Folder then Folder:Destroy() end
    Folder = Instance.new("Folder")
    Folder.Name = FolderName
    Folder.Parent = Model
    Size = Size or Vector3.new(4, 5, 3)
    local Ox, Oy, Oz = Size.X / 2, Size.Y / 2, Size.Z / 2
    local Edges = {
        {Vector3.new(0, Oy, Oz), Vector3.new(Size.X, 0.1, 0.1)},
        {Vector3.new(0, Oy, -Oz), Vector3.new(Size.X, 0.1, 0.1)},
        {Vector3.new(-Ox, Oy, 0), Vector3.new(0.1, 0.1, Size.Z)},
        {Vector3.new(Ox, Oy, 0), Vector3.new(0.1, 0.1, Size.Z)},
        {Vector3.new(0, -Oy, Oz), Vector3.new(Size.X, 0.1, 0.1)},
        {Vector3.new(0, -Oy, -Oz), Vector3.new(Size.X, 0.1, 0.1)},
        {Vector3.new(-Ox, -Oy, 0), Vector3.new(0.1, 0.1, Size.Z)},
        {Vector3.new(Ox, -Oy, 0), Vector3.new(0.1, 0.1, Size.Z)},
        {Vector3.new(-Ox, 0, Oz), Vector3.new(0.1, Size.Y, 0.1)},
        {Vector3.new(Ox, 0, Oz), Vector3.new(0.1, Size.Y, 0.1)},
        {Vector3.new(-Ox, 0, -Oz), Vector3.new(0.1, Size.Y, 0.1)},
        {Vector3.new(Ox, 0, -Oz), Vector3.new(0.1, Size.Y, 0.1)},
    }
    for _, Edge in ipairs(Edges) do
        local Adornment = Instance.new("BoxHandleAdornment")
        Adornment.Adornee = RootPart
        Adornment.Size = Edge[2]
        Adornment.CFrame = CFrame.new(Edge[1])
        Adornment.Color3 = Color
        Adornment.Transparency = 0.2
        Adornment.ZIndex = 10
        Adornment.AlwaysOnTop = true
        Adornment.Visible = true
        Adornment.Parent = Folder
    end
    return Folder
end

local function Update3DBoxColor(Model, Color)
    local Folder = Model:FindFirstChild("Esp_3DBox")
    if Folder then
        for _, Adornment in ipairs(Folder:GetChildren()) do
            if Adornment:IsA("BoxHandleAdornment") then
                Adornment.Color3 = Color
            end
        end
    end
end

local function Remove3DBox(Model)
    local Folder = Model:FindFirstChild("Esp_3DBox")
    if Folder then Folder:Destroy() end
end

local function CreateHighlight(Model, Color)
    local Existing = Model:FindFirstChild("Esp_Highlight")
    if Existing then
        Existing.FillColor = Color
        Existing.OutlineColor = Color
        return Existing
    end
    local Highlight = Instance.new("Highlight")
    Highlight.Name = "Esp_Highlight"
    Highlight.Parent = Model
    Highlight.FillColor = Color
    Highlight.OutlineColor = Color
    Highlight.FillTransparency = 0.5
    Highlight.OutlineTransparency = 0.3
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    return Highlight
end

local function AddHighlight(Model, Color)
    if not Model then return end
    if not DConfiguration.Esp.HighlightCache[Model] then
        DConfiguration.Esp.HighlightCache[Model] = CreateHighlight(Model, Color)
    else
        local H = DConfiguration.Esp.HighlightCache[Model]
        H.FillColor = Color
        H.OutlineColor = Color
    end
end

local function RemoveHighlight(Model)
    if not Model then return end
    local H = DConfiguration.Esp.HighlightCache[Model]
    if H then
        H:Destroy()
        DConfiguration.Esp.HighlightCache[Model] = nil
