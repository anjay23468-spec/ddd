local function CheckAndFireAutoJoin()
    if not DConfiguration.AutoJoin.Enabled then return end
    local IsDead = false
    local DeathGui = PlayerGui:FindFirstChild("Shared")
    if DeathGui then
        local Respawn = DeathGui:FindFirstChild("Respawn")
        if Respawn then
            local Types = Respawn:FindFirstChild("Types")
            if Types then
                local Death = Types:FindFirstChild("Death")
                if Death and Death.Visible then IsDead = true end
            end
        end
    end
    local Menu = PlayerGui:FindFirstChild("Menu")
    if Menu then IsDead = true end
    if IsDead then
        if not DConfiguration.AutoJoin.IsRejoining then DConfiguration.AutoJoin.IsRejoining = true end
        if DConfiguration.AutoJoin.IsRejoining then
            local Now = tick()
            if Now - DConfiguration.AutoJoin.LastFireTime >= 10 then
                DConfiguration.SelfRevive.ChangeMode:FireServer(true)
                DConfiguration.AutoJoin.LastFireTime = Now
            end
        end
    else
        DConfiguration.AutoJoin.IsRejoining = false
    end
end

