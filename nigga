DFunction.GetAllEmotes = function()
    local ItemsFolder = ReplicatedStorage:FindFirstChild("Items")
    if not ItemsFolder then return {} end
    local AllEmotes = {}
    local function FindEmotesFolders(Parent)
        for _, Child in ipairs(Parent:GetChildren()) do
            if Child:IsA("Folder") then
                if Child.Name == "Emotes" then
                    for _, Emote in ipairs(Child:GetChildren()) do
                        if Emote:IsA("ModuleScript") and Emote:GetAttribute("ID") then
                            table.insert(AllEmotes, { Name = Emote.Name, ID = Emote:GetAttribute("ID") })
                        end
                    end
                else
                    FindEmotesFolders(Child)
                end
            end
        end
    end
    FindEmotesFolders(ItemsFolder)
    return AllEmotes
end

DFunction.FindEmoteInfo = function(EmoteInput)
    if EmoteInput == "" then return nil end
    local Registry = require(ReplicatedStorage.Items.Registry)
    local Id = tonumber(EmoteInput)
    if Id then
        local Config = Registry.GetConfig(Id)
        if Config then
            local AllEmotes = DFunction.GetAllEmotes()
            for _, E in ipairs(AllEmotes) do
                if E.ID == Id then
                    return { Name = E.Name, ID = Id }
                end
            end
            return { Name = tostring(Id), ID = Id }
        else
            return nil
        end
    end
    local AllEmotes = DFunction.GetAllEmotes()
    for _, Emote in ipairs(AllEmotes) do
        if Emote.Name:lower() == EmoteInput:lower() then
            return { Name = Emote.Name, ID = Emote.ID }
        end
    end
    return nil
end

DFunction.SetEmote = function(EmoteId)
    if not EmoteId then return end
    local Player = game.Players.LocalPlayer
    local Character = Player.Character
    if not Character then return end
    local TagValue = Character:GetAttribute("Tag")
    if not TagValue then return end
    local TagBuf = buffer.create(2)
    buffer.writeu16(TagBuf, 0, TagValue)
    firesignal(ReplicatedStorage.Events.UpdateCharacterDataRegistry.OnClientEvent, {
        buffer.fromstring("\24\1"),
        EmoteId,
        TagBuf
    })
end

DFunction.BuildEmoteMapping = function()
    DConfiguration.EmoteChanger.Replacements = {}
    for i = 1, 12 do
        local CurrentInput = DConfiguration.EmoteChanger.CurrentSlots[i] or ""
        local SelectInput = DConfiguration.EmoteChanger.SelectSlots[i] or ""
        if CurrentInput ~= "" and SelectInput ~= "" then
            local CurrentInfo = DFunction.FindEmoteInfo(CurrentInput)
            local SelectInfo = DFunction.FindEmoteInfo(SelectInput)
            if CurrentInfo and SelectInfo then
                DConfiguration.EmoteChanger.Replacements[CurrentInfo.Name] = {
                    Select = SelectInfo.Name,
                    SelectId = SelectInfo.ID,
                    Slot = i
                }
            end
        end
    end
end

DFunction.StartEmoteWatcher = function()
    if DConfiguration.EmoteChanger.HookActive then return end
    DConfiguration.EmoteChanger.HookActive = true
    DConfiguration.EmoteChanger.EmoteClass.Activate = function(Self, P2, P3)
        DConfiguration.EmoteChanger.OrigActivate(Self, P2, P3)
        local Anim = Self.Animations and Self.Animations.Animation
        if Anim and Anim.IsPlaying and Anim.Speed > 0 then
            local Module = Self.EmoteModule
            local CurrentEmote = Module and Module.Name or "Unknown"
            if CurrentEmote ~= DConfiguration.EmoteChanger.LastEmoteName then
                if DConfiguration.EmoteChanger.Replacements[CurrentEmote] then
                    local Replacement = DConfiguration.EmoteChanger.Replacements[CurrentEmote]
                    local SelectId = Replacement.SelectId
                    if SelectId then
                        DConfiguration.EmoteChanger.LastEmoteName = CurrentEmote
                        DFunction.SetEmote(SelectId)
                    end
                end
                DConfiguration.EmoteChanger.LastEmoteName = CurrentEmote
            end
        end
    end
    DConfiguration.EmoteChanger.EmoteClass.Deactivate = function(Self, ...)
        DConfiguration.EmoteChanger.OrigDeactivate(Self, ...)
        DConfiguration.EmoteChanger.LastEmoteName = nil
    end
end

DFunction.StopEmoteWatcher = function()
    DConfiguration.EmoteChanger.HookActive = false
    DConfiguration.EmoteChanger.EmoteClass.Activate = DConfiguration.EmoteChanger.OrigActivate
    DConfiguration.EmoteChanger.EmoteClass.Deactivate = DConfiguration.EmoteChanger.OrigDeactivate
    DConfiguration.EmoteChanger.LastEmoteName = nil
end

