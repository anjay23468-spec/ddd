local CachedLagRayParams = RaycastParams.new()
CachedLagRayParams.FilterType = Enum.RaycastFilterType.Exclude

local function DoLag()
    local LagTime = DConfiguration.Player.LagSwitch.MSDelay * 0.002
    local Mode = DConfiguration.Player.LagSwitch.Mode
    local Char = LocalPlayer.Character
    if not Char then return end
    local Hrp = Char:FindFirstChild("HumanoidRootPart")
    if not Hrp then return end
    local StoredVel = Hrp.AssemblyLinearVelocity
    if StoredVel.Magnitude < 1 then return end
    local Start = tick()
    while tick() - Start < LagTime do end
    if Mode == "FastFlag" or LagTime < 0.2 then
        pcall(function() setfflag("MaxMissedWorldStepsRemembered", "9999") end)
        return
    end
    if Mode ~= "Demon" or LagTime < 0.2 then return end
    CachedLagRayParams.FilterDescendantsInstances = {Char}
    local HorizVel = Vector3.new(StoredVel.X, 0, StoredVel.Z)
    local Dir = HorizVel.Magnitude > 0 and HorizVel.Unit or Hrp.CFrame.LookVector
    local Dist = math.min(HorizVel.Magnitude * LagTime * math.random(2,4), 30)
    local TargetPos = Hrp.Position + Dir * Dist
    local FwdHit = workspace:Raycast(Hrp.Position, TargetPos - Hrp.Position, CachedLagRayParams)
    if FwdHit then TargetPos = FwdHit.Position - Dir * 2 end
    local function DS(D, L) return workspace:Raycast(Hrp.Position + D * L, Vector3.new(0,-60,0), CachedLagRayParams) end
    local Long = DS(Dir, 50)
    local Short = nil
    for I = 2, 20, 2 do local R = DS(Dir, I); if R then Short = R; break end end
    local LenB, ShortB, DirB, HovB, Ang, Early = 1, 1, 1, 0, 0, false
    local function ApplySlope(Hit, IsShort)
        local N = Hit.Normal; local A = math.deg(math.acos(N:Dot(Vector3.new(0,1,0))))
        if A < 20 or A > 80 then return end
        Ang = A
        if IsShort then
            ShortB = math.clamp(A/22,1,2.5); DirB = DirB + math.clamp(A/50,0,1.6); HovB = HovB + math.clamp((A-20)*0.05,0,3)
            local VD = Hrp.Position.Y - Hit.Position.Y
            if A >= 50 and VD < 3 then Early = true; TargetPos = TargetPos + Dir*4 + Vector3.new(0,4,0)
            elseif A < 35 then TargetPos = TargetPos + Vector3.new(0,3,0) + Dir*(2*DirB)
            else TargetPos = TargetPos + Vector3.new(0,A*0.4+HovB,0) end
        else
            LenB = math.clamp(A/25,1,2.2); DirB = math.clamp(A/40,1,2); HovB = math.clamp((A-20)*0.06,0,3)
            if A < 35 then TargetPos = TargetPos + Vector3.new(0,3,0) + Dir*(2*DirB)
            else TargetPos = TargetPos + Vector3.new(0,A*0.3+HovB,0) end
        end
    end
    if Long then ApplySlope(Long, false) end
    if Short then ApplySlope(Short, true) end
    if Ang >= 35 then TargetPos = TargetPos + Dir*(5*DirB) end
    local SC = workspace:Raycast(Hrp.Position, TargetPos - Hrp.Position, CachedLagRayParams)
    if SC then TargetPos = SC.Position + Vector3.new(0,2,0) - Dir*2 end
    if Short or Long then local HP = (Short or Long).Position; if Hrp.Position.Y - HP.Y < 2 then TargetPos = Hrp.Position + Dir*2 + Vector3.new(0,2,0) end end
    Hrp.CFrame = CFrame.new(TargetPos, TargetPos + Hrp.CFrame.LookVector)
    local Spd = StoredVel.Magnitude; local FwB = math.clamp(Spd*0.4,4,20)
    local Delta = TargetPos - Hrp.Position; local SD2 = Delta.Magnitude > 0 and Delta.Unit or Dir
    local SC2 = workspace:Raycast(Hrp.Position, SD2*FwB, CachedLagRayParams)
    if not SC2 then Hrp.AssemblyLinearVelocity += SD2*FwB
    else local D2 = (SC2.Position - Hrp.Position).Magnitude; if D2 > 3 then Hrp.AssemblyLinearVelocity += SD2*(D2*0.6) end end
    if StoredVel.Y < -10 then
        local BM = 1.2 + (Ang >= 45 and math.clamp((Ang-45)/20,0,1) or 0)
        if StoredVel.Y < -60 then BM *= 0.9*LenB*ShortB elseif StoredVel.Y < -30 then BM *= LenB*ShortB end
        local AF = math.clamp((Ang-20)/40,0,1)
        local BY = math.clamp((math.abs(StoredVel.Y)*(1.1+AF*0.9) + Spd*(0.3+AF*0.5))*BM, 0, 60+Spd*0.4)
        Hrp.AssemblyLinearVelocity = Vector3.new(StoredVel.X*DirB, BY, StoredVel.Z*DirB)
        if Early then
            local FB = math.clamp(5+Spd*0.1,6,20)
            local FC = workspace:Raycast(Hrp.Position, Dir*FB, CachedLagRayParams)
            if not FC then Hrp.CFrame = Hrp.CFrame + Dir*FB
            else local FD = (FC.Position - Hrp.Position).Magnitude; if FD > 3 then Hrp.CFrame = Hrp.CFrame + Dir*(FD*0.5) end end
        end
    end
    Hrp.Size = Vector3.new(3,20,3); task.wait(0.1); Hrp.Size = Vector3.new(2,4,2)
end

