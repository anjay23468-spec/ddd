    if DConfiguration.Esp.Enabled then return end  
    DConfiguration.Esp.Enabled = true
    DConfiguration.Esp.Connections.Render = RunService.RenderStepped:Connect(OnRenderStepped)
end

local function SetupEspWatchers()
    DConfiguration.Esp.Connections.RigAdded = workspace.DescendantAdded:Connect(function(Desc)
        if Desc:IsA("Model") and string.find(Desc.Name, "Rigs") then
            DConfiguration.Esp.LastRigUpdate = 0
        end
    end)
    DConfiguration.Esp.Connections.RigRemoved = workspace.DescendantRemoving:Connect(function(Desc)
        if Desc:IsA("Model") and string.find(Desc.Name, "Rigs") then
            local H = DConfiguration.Esp.HighlightCache[Desc]
            if H then H:Destroy(); DConfiguration.Esp.HighlightCache[Desc] = nil end
            local Owner = DConfiguration.Esp.RigOwner[Desc]
            if Owner then
                DConfiguration.Esp.RigOwner[Desc] = nil
                if DConfiguration.Esp.PlayerRigs[Owner] then
                    for i, Rig in ipairs(DConfiguration.Esp.PlayerRigs[Owner]) do
                        if Rig == Desc then table.remove(DConfiguration.Esp.PlayerRigs[Owner], i) break end
                    end
                end
            end
            for i, Rig in ipairs(DConfiguration.Esp.RigCache) do
                if Rig == Desc then table.remove(DConfiguration.Esp.RigCache, i) break end
            end
        end
    end)
    DConfiguration.Esp.Connections.PlayerAdded = Players.PlayerAdded:Connect(function()
        DConfiguration.Esp.LastRigUpdate = 0
    end)
    DConfiguration.Esp.Connections.PlayerRemoving = Players.PlayerRemoving:Connect(function(Player)
        if Player.Character then RemoveHighlight(Player.Character) end
        DConfiguration.Esp.PlayerRigs[Player] = nil
    end)
end

SetupEspWatchers()

RunService.RenderStepped:Connect(function()
    DConfiguration.Esp.LastRenderTime = tick()
    DConfiguration.Esp.Rendering = true
end)

DConfiguration.Esp.Connections.RenderCheck = RunService.Heartbeat:Connect(function()
