local AutoCarryLastAttempt = 0
local AutoCarryCooldown = 0.5
local AutoCarryStates = { "Carry", "CarrySlide", "CarrySlideAir", "CarryAir", "Carried", "CarryMove", "CarryIdle" }

local function AutoCarryIsCarrying()
    local Cd = pcall(function() return CharacterService:GetCharacterFromPlayer(LocalPlayer) end) and CharacterService:GetCharacterFromPlayer(LocalPlayer)
    if not Cd then return false end
    local State = Cd.Movement and Cd.Movement.State
    if not State then return false end
    for _, S in ipairs(AutoCarryStates) do if State == S then return true end end
    return false
end

local function AutoCarryIsPlayerValid(Player)
    if not Player.Character then return false end
    local Cd = nil
    pcall(function() Cd = CharacterService:GetCharacterFromPlayer(Player) end)
    if not Cd then return false end
    if not (Cd.DataRegistry and Cd.DataRegistry:Get("Downed")) then return false end
    if Cd.DataRegistry:Get("Ragdolling") then return false end
    return true
end

DFunction.StartAutoCarry = function()
    if DConfiguration.AutoCarry.Connection then return end
    DConfiguration.AutoCarry.Connection = RunService.Heartbeat:Connect(function()
        if not DConfiguration.AutoCarry.Enabled then return end
        local Char = LocalPlayer.Character
        if not Char then return end
        local Hrp = Char:FindFirstChild("HumanoidRootPart")
        if not Hrp then return end
        if AutoCarryIsCarrying() then return end
        local Now = tick()
        if Now - AutoCarryLastAttempt < AutoCarryCooldown then return end
        for _, Other in ipairs(Players:GetPlayers()) do
            if Other == LocalPlayer then continue end
            if not AutoCarryIsPlayerValid(Other) then continue end
            local OtherHrp = Other.Character:FindFirstChild("HumanoidRootPart")
            if not OtherHrp then continue end
            if (Hrp.Position - OtherHrp.Position).Magnitude <= 20 then
                local Tag = Other.Character:GetAttribute("Tag")
                if Tag then
                    pcall(function() ReplicatedStorage.Events.Interact:FireServer("Carry", Tag) end)
                    AutoCarryLastAttempt = Now
                    break
                end
            end
        end
    end)
end

DFunction.StopAutoCarry = function()
    if DConfiguration.AutoCarry.Connection then
        DConfiguration.AutoCarry.Connection:Disconnect()
        DConfiguration.AutoCarry.Connection = nil
    end
    if AutoCarryIsCarrying() then
        pcall(function() ReplicatedStorage.Events.Interact:FireServer("UnCarry") end)
    end
end

