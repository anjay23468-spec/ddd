task.spawn(function()
    local Ok, Mod = pcall(function()
        return require(LocalPlayer:WaitForChild("PlayerScripts", 10):WaitForChild("PlayerModule", 10):WaitForChild("ControlModule", 10))
    end)
    if Ok and Mod then AutoWalkControlModule = Mod end
end)

local function AutoWalkStart()
    if not AutoWalkControlModule then return end
    local Dir = DConfiguration.AutoWalk.MoveDirection
    Dir = Dir.Magnitude > 0 and Dir.Unit or Vector3.new(0, 0, 1)
    AutoWalkOldGetMoveVector = AutoWalkControlModule.GetMoveVector
    AutoWalkControlModule.GetMoveVector = function(...)
        local Input = AutoWalkOldGetMoveVector(...)
        return Input.Magnitude > 0.1 and Input or Dir
    end
    if AutoWalkJumpConn then AutoWalkJumpConn:Disconnect() end
    AutoWalkLastVel = Vector3.new()
    AutoWalkJumpConn = RunService.Heartbeat:Connect(function()
        local Char = LocalPlayer.Character
        if not Char then return end
        local Hum = Char:FindFirstChild("Humanoid")
        local Root = Char:FindFirstChild("HumanoidRootPart")
        if not Hum or not Root then return end
        local State = Hum:GetState()
        if State == Enum.HumanoidStateType.Jumping then
            if AutoWalkLastVel.Magnitude > 0 then
                local CurVel = Root.AssemblyLinearVelocity
                if CurVel.Magnitude < AutoWalkLastVel.Magnitude then
                    pcall(function()
                        Root.AssemblyLinearVelocity = Vector3.new(AutoWalkLastVel.X, CurVel.Y, AutoWalkLastVel.Z)
                    end)
                end
            end
            AutoWalkLastVel = Root.AssemblyLinearVelocity
        elseif State == Enum.HumanoidStateType.Landed then
            AutoWalkLastVel = Vector3.new()
        end
    end)
end

local function AutoWalkStop()
    if AutoWalkControlModule and AutoWalkOldGetMoveVector then
        AutoWalkControlModule.GetMoveVector = AutoWalkOldGetMoveVector
        AutoWalkOldGetMoveVector = nil
    end
    if AutoWalkJumpConn then AutoWalkJumpConn:Disconnect(); AutoWalkJumpConn = nil end
    AutoWalkLastVel = Vector3.new()
end

